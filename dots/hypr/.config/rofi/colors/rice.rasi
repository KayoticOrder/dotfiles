/**
 * Custom color scheme matching the rest of the desktop:
 * background / border pulled from waybar (style.css), accent from
 * Hyprland's active_border and waybar's active-workspace underline.
 **/
* {
    background:     #16161EFF;
    background-alt: #1E1F29FF;
    foreground:     #D6D2B6FF;
    foreground-dim: #6C6F93FF;
    border:         #363748FF;
    selected:       #7CB0C5FF;
    active:         #95B66BFF;
    urgent:         #F85B61FF;
}
