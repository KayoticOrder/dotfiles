#!/usr/bin/env bash
# Run a build on the build machine from the current repo and pull its artifacts back.
set -o pipefail

usage() {
	echo "usage: rbuild [-c] [-s] [-H host] [-d remote_dir] [-a artifact]... [-x exclude]... -- command [args...]" >&2
	exit 2
}

host=${RBUILD_HOST:-buildbox}
remote_dir=
artifacts=()
excludes=()
sync=
checkout=
while getopts csH:d:a:x: opt; do
	case $opt in
	c) checkout=1 ;;
	s) sync=1 ;;
	H) host=$OPTARG ;;
	d) remote_dir=$OPTARG ;;
	a) artifacts+=("$OPTARG") ;;
	x) excludes+=(--exclude "$OPTARG") ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || usage

local_root=$(git rev-parse --show-toplevel 2>/dev/null) || local_root=$PWD
if [ -z "$remote_dir" ]; then
	case $local_root in
	"$HOME"/*) remote_dir=${local_root#"$HOME"/} ;;
	*)
		echo "rbuild: $local_root is outside \$HOME, pass -d" >&2
		exit 2
		;;
	esac
fi

# Compilers print physical paths, so resolve symlinks before rewriting them to local ones.
remote_root=$(ssh "$host" "cd $(printf %q "$remote_dir") && pwd -P") || exit
from=$(printf '%s' "$remote_root" | sed 's/[][\.*^$#]/\\&/g')
to=$(printf '%s' "$local_root" | sed 's/[\&#]/\\&/g')

# Put the build machine on the same commit (detached), discarding edits to tracked files there:
# its checkout is treated as a mirror, and -s re-applies local edits on top. Untracked files stay.
if [ -n "$checkout" ]; then
	sha=$(git -C "$local_root" rev-parse HEAD) || exit
	ssh "$host" "cd $(printf %q "$remote_root") || exit
		git fetch --quiet --all || exit
		if ! git cat-file -e '$sha^{commit}' 2>/dev/null; then
			echo 'rbuild: commit $sha is not on the build machine; push it first' >&2
			exit 1
		fi
		git checkout --quiet --force --detach $sha &&
			git submodule update --quiet --init --recursive --force" || exit
fi

# Tracked plus untracked-but-not-ignored files, so build outputs and .git stay put remotely.
# Remote copies of files deleted locally are left alone.
sync_tree() {
	git -C "$local_root/$1" ls-files -z -co --exclude-standard |
		rsync -az --from0 --files-from=- --ignore-missing-args \
			"$local_root/$1" "$host:$remote_root/$1"
}

if [ -n "$sync" ]; then
	sync_tree "" || exit
	# ls-files lists a submodule as a bare directory, so each one gets its own pass.
	while IFS= read -r -d '' sub; do
		sync_tree "$sub/" || exit
	done < <(cd "$local_root" && git submodule foreach --recursive --quiet 'printf "%s\0" "$displaypath"')
fi

# A remote pty makes the build flush output line by line (and stops it when rbuild is killed);
# strip the CRs and color codes it adds, and keep sed unbuffered so progress shows live.
ssh -qtt "$host" "cd $(printf %q "$remote_root") && $(printf '%q ' "$@")" 2>&1 |
	sed -u -e 's/\r$//' -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e "s#$from#$to#g" || exit

# Artifacts are repo-relative dirs, files or globs (expanded remotely). The /./ makes -R keep
# each path below the repo root; --delete only mirrors dirs and spares excluded files.
if [ ${#artifacts[@]} -gt 0 ]; then
	srcs=()
	for a in "${artifacts[@]}"; do
		srcs+=("$host:$remote_root/./$a")
	done
	rsync -azR --delete "${excludes[@]}" "${srcs[@]}" "$local_root/" || exit
fi
