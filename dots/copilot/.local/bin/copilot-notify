#!/usr/bin/env bash
# Copilot CLI agentStop hook: desktop notification when Copilot finishes a reply,
# unless you're already looking at it. Prints nothing, since agentStop hook
# output can make Copilot keep going instead of stopping.

dir=$(sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
msg="Finished working${dir:+ in ${dir##*/}}"
notify() { "$HOME/.local/bin/desktop-notify" "$@" >/dev/null 2>&1; exit 0; }

# In tmux we can tell exactly: the pane is on screen and a client's terminal has
# focus ("focused" relies on focus-events, which tmux.conf turns on).
# Outside tmux the best we can do is ask the OS whether the terminal is focused.
if [ -n "$TMUX" ] && [ -n "$TMUX_PANE" ]; then
	if [ "$(tmux display -p -t "$TMUX_PANE" '#{pane_active}#{window_active}' 2>/dev/null)" = 11 ] &&
		tmux list-clients -t "$TMUX_PANE" -F '#{client_flags}' 2>/dev/null | grep -q focused; then
		exit 0
	fi
	notify "GitHub Copilot" "$msg"
fi

if command -v hyprctl >/dev/null; then
	# the focused window is ours if its pid is one of our ancestors
	fg=$(hyprctl activewindow 2>/dev/null | sed -n 's/^[[:space:]]*pid: //p')
	p=$$
	while [ -n "$fg" ] && [ "${p:-0}" -gt 1 ]; do
		[ "$p" = "$fg" ] && exit 0
		p=$(ps -o ppid= -p "$p" | tr -d ' ')
	done
fi
notify -f WindowsTerminal "GitHub Copilot" "$msg"
